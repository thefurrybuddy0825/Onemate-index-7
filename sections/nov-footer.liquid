{% assign sst = section.settings %}
<footer{% if sst.animate == true %} class="wow fadeInUp animated"{% endif %} data-section-id="{{ section.id }}" data-section-type="nov-slick">
  <div class="footer-layout pt-95 pb-80 pb-xs-40">
    <div class="container-fluid">
      {% if sst.show_footer_top %}
        <div class="footer-top{% if section.blocks.size > 0 %} mb-100{% endif %}">
          <div class="row">
            <div class="block-menu col-md-3 col-6">
              {% if sst.menu_top %}
                <div class="footer_menu">
                  {% if sst.menu_title %}
                    <div class="title-block">{{ sst.menu_title }}</div>
                  {% endif %}
                  <ul class="site-footer__linklist list-unstyled pb-xs-30">
                    {% for link in linklists[sst.menu_top].links %}
                      <li class="site-footer__linklist-item">
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
            <div class="block-news col-md-6 col-12">
              {% if sst.show_news %}
                <div class="footer_newsletter">
                  {% if sst.news_title != blank or sst.news_stitle != blank %}
                    {% if sst.news_title != blank %}
                      <div class="title-block text-center">{{ sst.news_title }}</div>
                    {% endif %}
                    {% if sst.news_stitle != blank %}
                      <div class="sub_title mb-35 text-center">{{ sst.news_stitle }}</div>
                    {% endif %}
                  {% endif %}  
                  <div class="block-content">
                    {% form 'customer', id: 'footer_contact' %}
                      {{ form.errors | default_errors }}
                      {% if form.posted_successfully? %}
                        <p class="form--success text-center">{{ 'general.newsletter_form.confirmation' | t }}</p>
                      {% else %}
                        <div class="input-group">
                          <i class="zmdi zmdi-email c_df"></i>
                          <input type="hidden" name="contact[tags]" value="newsletter">
                          <input type="email"
                            name="contact[email]"
                            id="Email_Footer"
                            required
                            class="input-group__field newsletter__input form-control"
                            value="{% if customer %}{{ customer.email }}{% endif %}"
                            placeholder="{{ 'general.newsletter_form.email_newsletter' | t }}">
                            <button type="submit" class="btn newsletter__submit" name="commit">
                              {{ 'general.newsletter_form.submit' | t }}
                            </button>
                        </div>
                      {% endif %}
                    {% endform %}
                    <div class="text-center mt-35">
                      {% include 'nov-social' %}
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
            <div class="block-multi footer_multi col-md-3 col-6 d-lg-flex justify-content-end">
              <div>
                {% if settings.show_multiple_currencies == true and sst.enable_currency %}
                  <div class="footer-currency">
                    {% if sst.c_t != blank %}
                      <div class="title font-500 text-uppercase mb-15">{{ sst.c_t }}</div>
                    {% endif %}
                    {% include 'nov-block-currency', type: 'dropdown' %}
                  </div>
                {% endif %}
                {%- if sst.enable_language and localization.available_languages.size > 1 -%}
                  <div class="footer-language mt-25">
                    {% if sst.l_t != blank %}
                      <div class="title font-500 text-uppercase mb-15">{{ sst.l_t }}</div>
                    {% endif %}
                    {% include 'nov-block-language', id: 'footer-top-language' %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="row">
          {% for block in section.blocks %}
            {% assign bst = block.settings %}
            {% if block.type == 'block_contact' %}
              <div class="footer_contact block_footer{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                  <div class="title-block position-relative">
                    {{ bst.block_title }}
                    {% if sst.mobile_acc %}
                      <span class="f_btn_sl d-sm-none"><i class="zmdi zmdi-plus"></i></span>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-30">
                      {% if bst.block_subtitle != blank %}
                        <div class="footer-subtitle">{{ bst.block_subtitle }}</div>
                      {% endif %}
                      {% if bst.phone != blank %}
                        <div class="footertop-item__contact d-flex align-items-center">
                          {% if bst.img_phone != blank %}
                            <div class="footertop-item__icon">
                              <img data-src="{{ bst.img_phone | img_url: '50x' }}" class="lazyload">
                            </div>
                          {% endif %}
                            <span class="phone font-700">{{ bst.phone }}</span>
                        </div>
                      {% endif %}
                      {% if bst.email != blank %}
                        <div class="footertop-item__contact d-flex align-items-center">
                          {% if bst.img_email != blank %}
                            <div class="footertop-item__icon">
                              <img data-src="{{ bst.img_email | img_url: '50x' }}" class="lazyload">
                            </div>
                          {% endif %}
                            <span>{{ bst.email }}</span>
                        </div>
                      {% endif %}
                      {% if bst.open != blank %}
                        <div class="footertop-item__contact d-flex align-items-center">
                          {% if bst.img_open != blank %}
                            <div class="footertop-item__icon">
                              <img data-src="{{ bst.img_open | img_url: '50x' }}" class="lazyload">
                            </div>
                          {% endif %}
                            <span>{{ bst.open }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_menu' %}
              {%- assign footer_linklist = bst.menu_handle -%}
              <div class="footer_menu block_footer{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                    <div class="title-block">
                      {{ bst.block_title }}
                      {% if sst.mobile_acc %}
                        <span class="f_btn_sl d-sm-none"><i class="zmdi zmdi-plus"></i></span>
                      {% endif %}
                    </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    {% if linklists[footer_linklist].links.size > 0 %}
                      <ul class="site-footer__linklist list-unstyled pb-xs-30">
                        {% for link in linklists[footer_linklist].links %}
                          <li class="site-footer__linklist-item">
                            <a href="{{ link.url }}">{{ link.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_html' %}
              <div class="footer_html block_footer{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                  <div class="title-block">
                    {{ bst.block_title }}
                    {% if sst.mobile_acc %}
                      <span class="f_btn_sl d-sm-none"><i class="zmdi zmdi-plus"></i></span>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-30">
                      {% if bst.img != blank %}<img data-src="{{ bst.img | img_url: '190x' }}" class="lazyload mb-30 mb-md-10">{% endif %}
                      {% if bst.html_content != blank %}
                        <div class="bl_html">{{ bst.html_content }}</div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if block.type == 'block_multi' %}
              <div class="footer_multi block_footer{% if bst.block_title != blank and sst.mobile_acc %} mt-xs-0 mb-xs-0{% endif %} {{ bst.grid_xl }} {{ bst.grid_lg }} {{ bst.grid_md }} {{ bst.grid_sm }}{% if bst.block_class != blank %} {{ bst.block_class }}{% endif %}">
                <div class="block h-100">
                  {% if bst.block_title != blank %}
                  <div class="title-block{% if bst.h_t %} d-sm-none{% endif %}">
                    {{ bst.block_title }}
                    {% if sst.mobile_acc %}
                      <span class="f_btn_sl d-sm-none"><i class="zmdi zmdi-plus"></i></span>
                    {% endif %}
                  </div>
                  {% endif %}
                  <div class="block-content{% if bst.block_title != blank and sst.mobile_acc %} h_t{% endif %}">
                    <div class="pb-xs-30">
                      {% if settings.show_multiple_currencies == true and bst.enable_currency %}
                        <div class="footer-currency">
                          {% if bst.c_t != blank %}
                            <div class="title font-500 text-uppercase mb-15">{{ bst.c_t }}</div>
                          {% endif %}
                          {% include 'nov-block-currency', type: 'dropdown' %}
                        </div>
                      {% endif %}
                      {%- if bst.enable_language and localization.available_languages.size > 1 -%}
                        <div class="footer-language mt-25">
                          {% if bst.l_t != blank %}
                            <div class="title font-500 text-uppercase mb-15">{{ bst.l_t }}</div>
                          {% endif %}
                          {% include 'nov-block-language', id: 'footer-language' %}
                        </div>
                      {%- endif -%}
                      {% if bst.social %}
                        <div class="mt-25">
                          {% if bst.s_t != blank %}
                            <div class="title font-500 text-uppercase mb-15">{{ bst.s_t }}</div>
                          {% endif %}
                          {% include 'nov-social' %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
  <div class="footer_copyright pb-sm-50">
    <div class="container-fluid">
      <div class="d-xl-flex align-items-center justify-content-between text-center text-xl-left pt-45 pb-45">
        <div class="copyright text-center">{{ sst.copyright }}</div>
        <ul class="copyright-menu list-unstyled d-flex justify-content-sm-center mt-lg-15">
          {% for link in linklists[sst.menu_copyright].links %}
            <li class="linklist-item">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
        {% if sst.payment != blank or shop.enabled_payment_types %}
          <div class="footer__payment d-flex flex-wrap justify-content-center mt-lg-15">
            {% if sst.payment != blank %}
              <img src="{{ sst.payment | img_url: '250x' }}">
            {% else %}
              {%- for type in shop.enabled_payment_types -%}
                <div class="payment__item mt-sm-15">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</div>
              {%- endfor -%}
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</footer>
{% schema %}
